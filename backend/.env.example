# BetIQ API Keys — copy to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Required — server won't start without this
ODDS_API_KEY=your_theoddsapi_key_here

# Optional — needed for specific features
BALLDONTLIE_API_KEY=your_balldontlie_key_here
CFB_API_KEY=your_cfb_api_key_here
FOOTBALL_DATA_KEY=your_football_data_org_key_here
ODDSPAPI_KEY=your_oddspapi_key_here
API_FOOTBALL_KEY=your_api_football_key_here

# Email alerts (SMTP via Gmail app password)
SMTP_PASS=your_gmail_app_password_here
